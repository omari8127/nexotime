# Copia a ".env" (solo para correr en tu propia máquina). En un hosting, define estas variables en su panel.

PORT=8787
# Base de datos SQLite (un solo archivo). En hosting, ponla en un volumen persistente.
DB_PATH=./data/licenses.db

# Llave privada de firma (ES256). Opción A: archivo generado con "npm run keygen".
LICENSE_PRIVATE_KEY_FILE=./data/private.pem
# Opción B: el contenido PEM completo en una variable (con \n en vez de saltos de línea).
# LICENSE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Detrás de un proxy (Railway, Render, Fly, nginx, Cloudflare): true, para registrar la IP real.
TRUST_PROXY=false

# Orígenes que pueden llamar a la API pública desde un navegador. "*" es válido: cada llamada está autenticada.
ALLOWED_ORIGINS=*
