{
  "name": "nexotime-license-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Servidor de licencias y activación de NEXOTIME. Sin dependencias: solo Node.js 22.5+.",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "keygen": "node --disable-warning=ExperimentalWarning src/cli.js keygen",
    "create-owner": "node --disable-warning=ExperimentalWarning src/cli.js create-owner",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  }
}
