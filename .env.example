# Copia este archivo a ".env.local" (ese sí lo lee Vite; no se sube a git) y pon tus valores.

# --- Supabase: Project Settings → API -----------------------------------------
# La "anon public key" es segura para el navegador; la seguridad real la da RLS
# (supabase/README.md). NUNCA pongas aquí la "service_role key".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Licencias ----------------------------------------------------------------
# Dirección (HTTPS en producción) de tu servidor de licencias.
VITE_LICENSE_API_URL=http://localhost:8787
# Llave PÚBLICA que imprime "npm run keygen" en license-server. Solo verifica, no firma.
VITE_LICENSE_PUBLIC_KEY=
# Solo para desarrollo: desactiva la exigencia de activación.
# VITE_LICENSE_ENFORCE=false
