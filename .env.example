# Copia este archivo a ".env.local" (ese sí lo lee Vite) y pon tus valores
# reales de Supabase: Project Settings → API en tu dashboard de supabase.com.
#
# La "anon public key" es segura para el navegador — Supabase la diseñó para
# eso; la seguridad real la da RLS (ver supabase/schema.sql). NUNCA pongas
# aquí la "service_role key".

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key
