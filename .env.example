# Copia este archivo a ".env.local" (ese sí lo lee Vite; no se sube a git) y pon tus valores.

# --- Supabase: Project Settings → API -----------------------------------------
# La "anon public key" es segura para el navegador; la seguridad real la da RLS
# (supabase/README.md). NUNCA pongas aquí la "service_role key".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Suscripciones (reemplaza las licencias, ver docs/ESTADO.md) --------------
# Solo para "npm run record-payment" (nunca la usa el navegador): la llave
# "service_role" de Project Settings → API. Secreta — nunca la pongas con el
# prefijo VITE_, eso la mandaría al navegador de cualquiera que abra la app.
SUPABASE_SERVICE_ROLE_KEY=

# --- Licencias (en desuso, Fase 2/3 ya las reemplazó por lo de arriba) --------
# VITE_LICENSE_API_URL=http://localhost:8787
# VITE_LICENSE_PUBLIC_KEY=
